{
  "name": "simcheong-jeon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "심청전 - a procedurally rendered Three.js cinematic of the Korean folk tale",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:test": "node --test \"scripts/**/*.test.mjs\"",
    "audit:check": "node scripts/check-render-harness.mjs",
    "audit:capture": "node scripts/capture.mjs",
    "audio:generate": "node --experimental-strip-types scripts/tts.mjs",
    "audio:check": "node --experimental-strip-types scripts/tts.mjs --check",
    "audio:script": "node --experimental-strip-types scripts/audio-script.mjs",
    "audio:manifest": "node --experimental-strip-types scripts/audio-manifest.mjs",
    "seedance:map": "node --experimental-strip-types scripts/seedance-map.mjs",
    "audio:script:bare": "node --experimental-strip-types scripts/audio-script.mjs --bare"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
